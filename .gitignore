# --- Host build output -------------------------------------------------------
# Paths follow the engine to saturn/src/; the old src/ spellings stopped
# matching at 6d31b11 and left the built binary showing as untracked.
saturn/src/*.o
saturn/src/alien
saturn/src/alien.exe

# --- Subagent-driven-development scratch -------------------------------------
# Ledger, task briefs, reports and review packages for an in-flight plan.
# Regenerated from the plan and git history; never part of the source tree.
.superpowers/

# --- Saturn build output -----------------------------------------------------
saturn/BuildDrop/
**/*.o
**/*.elf
**/*.iso
**/*.bin.tmp

# --- Cross-compiler and iso2raw (fetched into the SDK submodule, never committed)
SaturnRingLib/Compiler/
SaturnRingLib/tools/bin/

# --- Host/IDE build dirs -----------------------------------------------------
# .idea/ is deliberately NOT here: Another-Saturn commits its CLion project
# files and this repo follows that blueprint.
# CLion creates cmake-build-debug, cmake-build-release, etc. at the project root.
# The leading slash anchors this to the repo root; without it, an unanchored
# cmake-build-*/ at any depth would match, which is not intended.
/cmake-build-*/

# --- Host unit-test binaries -------------------------------------------------
# saturn/tests/run_tests.sh builds these with the host gcc, not the SH-2 cross
# compiler, so the pure disc-format logic and the map-size contract can be
# tested off-target. Build output, not source. Both spellings: MSYS gcc emits
# .exe on Windows.
saturn/tests/run_tests
saturn/tests/run_tests.exe
saturn/tests/run_tests_vm
saturn/tests/run_tests_vm.exe
saturn/tests/run_tests_cdtoc
saturn/tests/run_tests_cdtoc.exe
saturn/tests/run_tests_cdda_classify
saturn/tests/run_tests_cdda_classify.exe
saturn/tests/run_tests_discsec
saturn/tests/run_tests_discsec.exe
saturn/tests/run_tests_sfxconv
saturn/tests/run_tests_sfxconv.exe

# --- Extractor binary --------------------------------------------------------
tools/extract_disc
tools/extract_disc.exe

# --- Non-free game data ------------------------------------------------------
# The source Sega CD rip: 42 tracks, 425 MB, copyrighted. Required to build a
# disc, never committed. Listed as a bare directory because the track filenames
# contain spaces and parentheses that are awkward to match individually.
# The leading slash anchors this to the repo root; without it, an unanchored cd/
# matches any directory named cd at any depth, including saturn/cd/, whose
# tracklist files (saturn/cd/music/tracklist, saturn/cd/music-off/tracklist) must
# stay tracked. That is the reason the house style here carries comments: a path
# list alone does not explain why those paths must stay visible.
/cd/

# Everything extracted from it is the same data in a different shape.
# The 19 engine blobs. Both cases: ISO9660 stores them uppercase, but an
# extractor or a case-insensitive copy can produce either, and git's ignore
# matching is case-sensitive wherever core.ignorecase is false (e.g. CI on Linux).
saturn/cd/data/*.BIN
saturn/cd/data/*.bin

# The 41 CD-DA tracks and sox's raw intermediates, ~828 MB with HOTA_AUDIO=full.
# cd/music/tracklist is NOT ignored: it is the track ordering, it contains no
# game data, and without it shared.mk falls back to `find` order and lays the
# music onto the disc in an arbitrary sequence.
saturn/cd/music/*.wav
saturn/cd/music/*.raw

# SGL sound driver files the makefile copies in when SRL_USE_SGL_SOUND_DRIVER=1,
# and the linked program objcopy'd into the image. Build output, not source.
saturn/cd/data/0.bin
saturn/cd/data/SDDRVS.DAT
saturn/cd/data/SDDRVS.TSK
saturn/cd/data/BOOTSND.MAP

# Part I's PC DOS data, installed by the setup kit's part1 step. Both cases:
# Another-Saturn's bank.cxx builds the name lower-case with sprintf("bank%02x")
# and ISO9660 stores it upper-case, so either spelling can appear depending on
# where it was copied from, and git's ignore matching is case-sensitive
# wherever core.ignorecase is false, such as CI on Linux. ANOTHER.BIN and
# MEMLIST.BIN are already covered by the saturn/cd/data/*.BIN rule above.
saturn/cd/data/BANK*
saturn/cd/data/bank*

# Part I's opening movie. Committed in Another-Saturn, copied in here by
# tools/another/fetch.sh -- build output on this side of the fence.
saturn/cd/data/OPENING.CPK

# --- Part I checkout ---------------------------------------------------------
# tools/another/fetch.sh clones Another-Saturn here at the pinned ref, with its
# own SaturnRingLib. Never committed; safe to delete.
/.another/

# --- Part I's staged data step -----------------------------------------------
# tools/another/fetch.sh copies Another-Saturn's data.bat and a path-corrected
# CONFIG.ME here from the pinned checkout above, so the setup kit's
# update.bat has one place to find Part I's data step whether this is a
# source checkout or the released kit. Regenerated by fetch.sh; the released
# kit gets its own copy staged by CI, not this one.
/tools/assets/part1/
